{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flipbaz-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "flipbaz-sockets-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file-if-exists=.env.local",
        "server.js",
        "--production",
        "--port=3002"
      ],
      "port": 3002,
      "autoPort": false
    }
  ]
}
