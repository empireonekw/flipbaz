# Copy to .env.local and fill in real values. NEVER commit .env.local.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flipbaz?retryWrites=true&w=majority"

# Long random string used to sign session cookies (e.g. `openssl rand -base64 48`)
JWT_SECRET="change-me-to-a-long-random-string"

# Admin account created by `npm run seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-admin-password"

# Demo seller account created by `npm run seed` (has an active membership)
DEMO_SELLER_EMAIL="seller@flipbaz.test"
DEMO_SELLER_PASSWORD="change-me-seller-password"

# Public site URL (used for absolute links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp number in international format, digits only (used for wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER="923000000000"

# Flat shipping fee per order in PKR
NEXT_PUBLIC_SHIPPING_FEE="250"

# Where sellers send manual payments (shown on the checkout screen)
PAYMENT_JAZZCASH_NUMBER="0300-0000000"
PAYMENT_JAZZCASH_TITLE="Account Title"
PAYMENT_EASYPAISA_NUMBER="0345-0000000"
PAYMENT_EASYPAISA_TITLE="Account Title"
PAYMENT_BANK_NAME="Bank Name"
PAYMENT_BANK_TITLE="Account Title"
PAYMENT_BANK_ACCOUNT="0000000000000"
PAYMENT_BANK_IBAN="PK00XXXX0000000000000000"
